# /etc/hardlylistening/hardlylistening.env — packaged install defaults.
# Owner root:hardlylistening, mode 640: it is read by the service account and nothing else.

# Listen. Loopback, because a reverse proxy owns the public side.
HARDLYLISTENING_HOST=127.0.0.1
HARDLYLISTENING_PORT=8470

# Where this process may write: database and caches. Must match ReadWritePaths in the unit.
HARDLYLISTENING_DATA_DIR=/var/lib/hardlylistening

# The library. This only seeds a database whose root is still the built-in default; after
# that the value in the UI wins and this line does nothing.
HARDLYLISTENING_MUSIC_DIR=/srv/hardlylistening/music

# Accounts. Set this before exposing the port to anything but the proxy.
HARDLYLISTENING_AUTH_REQUIRED=1
HARDLYLISTENING_PUBLIC_ORIGIN=https://music.example.com

HARDLYLISTENING_FEDERATION_ENABLED=0
# HARDLYLISTENING_AI_API_KEY=